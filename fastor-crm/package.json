{
  "name": "fastor-crm-api",
  "version": "1.0.0",
  "private": true,
  "description": "MongoDB-backed employee CRM with atomic enquiry ownership",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-mongo.ps1",
    "start": "node --env-file=.env src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.5"
  }
}
