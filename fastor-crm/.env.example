MONGODB_URI=mongodb://127.0.0.1:27017/fastor_crm
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=1h
PORT=3000
NODE_ENV=development
# Optional comma-separated browser origins. No browser CORS access by default.
CORS_ORIGINS=http://localhost:5173
# Integration tests use a fresh disposable database on this MongoDB server.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017
