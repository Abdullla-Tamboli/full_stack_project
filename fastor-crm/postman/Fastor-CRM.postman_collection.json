{
  "info": {
    "name": "Fastor CRM",
    "description": "Run registration, login and anonymous submission before claiming. Use separate environments for A/B employees. npm test verifies races and persistence.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "enquiryId",
      "value": ""
    },
    {
      "key": "employeeEmail",
      "value": "a@example.com"
    },
    {
      "key": "employeePassword",
      "value": "strong-password-123"
    }
  ],
  "item": [
    {
      "name": "Register employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Employee A\",\n  \"email\": \"{{employeeEmail}}\",\n  \"password\": \"{{employeePassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Created\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{employeeEmail}}\",\n  \"password\": \"{{employeePassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Logged in\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"token\", pm.response.json().data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Submit anonymous enquiry",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Visitor\",\n  \"email\": \"visitor@example.com\",\n  \"courseInterest\": \"Node.js\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/enquiries",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "enquiries"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Created\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"enquiryId\", pm.response.json().data.enquiry.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List shared unclaimed enquiries",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/enquiries/unclaimed",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "enquiries",
            "unclaimed"
          ]
        }
      }
    },
    {
      "name": "Claim enquiry",
      "request": {
        "method": "PATCH",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/enquiries/{{enquiryId}}/claim",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "enquiries",
            "{{enquiryId}}",
            "claim"
          ]
        }
      }
    },
    {
      "name": "List my enquiries",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/enquiries/mine",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "enquiries",
            "mine"
          ]
        }
      }
    }
  ]
}
